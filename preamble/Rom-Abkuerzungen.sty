\RequirePackage{xspace}
%% -- \renewcommand nötig, da \dh (T1-Kodierung) bereits definiert ist.
%%    \og gibt es nur mit babel-french, deshalb \providecommand.
%% -- Alle anderen mit \providecommand: Hat ein Autor z.B. \zB selbst
%%    definiert, gibt es keinen Fehler "already defined" bei \begin{document}.
\AtBeginDocument{%
    \providecommand{\zB}{\mbox{z.\,B.}\xspace}
    \providecommand{\iA}{\mbox{i.\,A.}\xspace}
    \providecommand{\iAllg}{\mbox{i.\,Allg.}\xspace}
    \renewcommand{\dh}{\mbox{d.\,h.}\xspace}
    \providecommand{\oAe}{\mbox{o.\,Ä.}\xspace}
    \providecommand{\uAe}{\mbox{u.\,Ä.}\xspace}
    \providecommand{\og}{\mbox{o.\,g.}\xspace}
    \providecommand{\ua}{\mbox{u.\,a.}\xspace}
    \providecommand{\inkl}{inkl.\xspace}
    \providecommand{\sog}{sog.\xspace}
    \providecommand{\bzgl}{bzgl.\xspace}
    \providecommand{\fue}{\mbox{f.\,ü.}\xspace}
    \providecommand{\vs}{vs.\xspace}
    \providecommand{\ca}{ca.\xspace}
    \providecommand{\bzw}{bzw.\xspace}
    \providecommand{\etc}{etc.\xspace}
    \providecommand{\usw}{usw.\xspace}
    \providecommand{\ggf}{ggf.\xspace}
    \providecommand{\evtl}{evtl.\xspace}
    \providecommand{\vgl}{vgl.\xspace}
}
\endinput

