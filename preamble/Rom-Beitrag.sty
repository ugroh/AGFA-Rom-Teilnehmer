%% -- Querverweise: \vref liefert Name + Nummer + Seitenhinweis, z.B.
%%    "Satz 1.1 auf der vorherigen Seite". Der Name kommt von hyperrefs
%%    \autoref (Satz, Lemma, Abschnitt, Gleichung, Abbildung, ...), der
%%    Seitenhinweis von varioref. Den Namen also NICHT von Hand davorschreiben.
%%    cleveref wird bewusst nicht geladen (es wuerde \vref ersetzen).
%%    \vref ist robust; gesichert wird deshalb das innere Makro (\vref<Leerzeichen>).
\expandafter\let\expandafter\Rom@vrefinner\csname vref \endcsname
\newcommand{\Rom@vrefnorm}[1]{{\let\ref\autoref\Rom@vrefinner{#1}}}
\newcommand{\Rom@vrefstar}[1]{{\let\ref\autoref\Rom@vrefinner*{#1}}}
\DeclareRobustCommand{\vref}{\@ifstar{\Rom@vrefstar}{\Rom@vrefnorm}}
%% -- \Vref = \vref (der Name von \autoref ist schon gross geschrieben)
\DeclareRobustCommand{\Vref}{\vref}

%% -- Review-Modus
\ifthenelse{\boolean{review}}{\RequirePackage[doublespacing]{setspace}}{}

