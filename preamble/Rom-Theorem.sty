%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% -- Rom-Theorem.sty -- Theorem-Umgebungen
%% -- Stand: 2026-09-24 (\captionsngerman statt \captionsgerman)
%% -- vorher:  2026-09-23 (Workaround fuer den TeX Live 2026 / thmtools-sibling-Bug;
%% --                   nthm und thm teilen jetzt den Zaehler mit ntheorem;
%% --                   refname={Singular,Plural} fuer cleveref: \cref, \vref)
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{./preamble/Rom-Theorem}

\RequirePackage{amsmath}
\RequirePackage{amsthm}
\RequirePackage{thmtools}

%% --- Workaround für TeX Live 2026 / thmtools-Bug ------------------------
%% Der LaTeX-Kernel 2026 fuehrt einen neuen \newcounteralias-Mechanismus
%% fuer Theorem-Umgebungen ein. thmtools 0.76 ist damit noch nicht
%% kompatibel: JEDES \declaretheorem[..., sibling=...]{...} bricht mit
%% "Command \c@<name> already defined" ab (offizieller Bug, siehe
%% https://github.com/muzimuzhi/thmtools/issues/75). Offizieller
%% Workaround (TeX Live 2026 Release Notes / Overleaf-Blog): vor den
%% \declaretheorem-Aufrufen \thmt@autorefsetup so umdefinieren, dass es
%% den neuen Kernel-Mechanismus nicht anstoesst.
\makeatletter
\@ifundefined{newcounteralias}{}{%
    \renewcommand\thmt@autorefsetup{\@xa\def\csname\thmt@envname autorefname\@xa\endcsname\@xa{\thmt@thmname}}%
}
\makeatother
%% -------------------------------------------------------------------------

%% Gleichungsnummerierung
%% --

\numberwithin{equation}{section}

%% -- Stile
%% --

\declaretheoremstyle[
  headfont=\bfseries, bodyfont=\itshape, headindent=5pt,
]{plain-style}
\declaretheoremstyle[
  headfont=\bfseries, bodyfont=\upshape, headindent=5pt,
]{upshape-style}
\declaretheoremstyle[
  headfont=\bfseries, bodyfont={\small\upshape}, headindent=5pt,
]{small-style}
\declaretheoremstyle[
  headfont=\itshape, bodyfont=\upshape, headindent=5pt,
]{special-style}

%% -- Theoremumgebungen MIT Nummer
%% --
%% -- refname={Singular,Plural} setzt \crefname fuer cleveref (\Crefname
%%    leitet cleveref daraus ab) und den Namen fuer \autoref.
%%    Voraussetzung: cleveref ist VOR diesem Paket geladen (Rom-Beitrag.sty).

\declaretheorem[style=plain-style,   
    name=Theorem,    
    refname={Theorem,Theoreme},
    numberwithin=section]{ntheorem}

\declaretheorem[style=plain-style,   
    name=Satz,       
    refname={Satz,Sätze},
    sibling=ntheorem]{nproposition}

\declaretheorem[style=plain-style,   
    name=Lemma,      
    refname={Lemma,Lemmata},
    sibling=ntheorem]{nlemma}

\declaretheorem[style=plain-style,
    name=Korollar,   
    refname={Korollar,Korollare},
    sibling=ntheorem]{ncorollary}

\declaretheorem[style=upshape-style, 
    name=Beispiel,   
    refname={Beispiel,Beispiele},
    sibling=ntheorem]{nexample}

\declaretheorem[style=upshape-style, 
    name=Beispiele,  
    refname={Beispiele,Beispiele},
    sibling=ntheorem]{nexamples}

\declaretheorem[style=upshape-style, 
    name=Definition, 
    refname={Definition,Definitionen},
    sibling=ntheorem]{ndefinition}
    
\declaretheorem[style=small-style,   
    name=Anmerkung,  
    refname={Anmerkung,Anmerkungen},
    sibling=ntheorem]{nremark}
    
\declaretheorem[style=small-style, 
    name=Anmerkungen,
    refname={Anmerkungen,Anmerkungen},
    sibling=ntheorem]{nremarks}
    
%% -- Kurzform

\declaretheorem[style=plain-style,   
    name=Theorem,    
    refname={Theorem,Theoreme},
    sibling=ntheorem]{nthm}

\declaretheorem[style=plain-style,   
    name=Satz,       
    refname={Satz,Sätze},
    sibling=ntheorem]{nprop}

\declaretheorem[style=plain-style,   
    name=Lemma,      
    refname={Lemma,Lemmata},
    sibling=ntheorem]{nlem}

\declaretheorem[style=plain-style,
    name=Korollar,   
    refname={Korollar,Korollare},
    sibling=ntheorem]{ncor}

\declaretheorem[style=upshape-style, 
    name=Beispiel,   
    refname={Beispiel,Beispiele},
    sibling=ntheorem]{nexamp}

\declaretheorem[style=upshape-style, 
    name=Beispiele,  
    refname={Beispiele,Beispiele},
    sibling=ntheorem]{nexamps}

\declaretheorem[style=upshape-style, 
    name=Definition, 
    refname={Definition,Definitionen},
    sibling=ntheorem]{ndefn}
    
\declaretheorem[style=small-style,   
    name=Anmerkung,  
    refname={Anmerkung,Anmerkungen},
    sibling=ntheorem]{nrem}
    
\declaretheorem[style=small-style, 
    name=Anmerkungen,
    refname={Anmerkungen,Anmerkungen},
    sibling=ntheorem]{nrems}

%% -- Theoremumgebungen OHNE Nummer
%% --

\declaretheorem[style=plain-style,   
    name=Theorem,    
    numbered=no]{theorem}

\declaretheorem[style=plain-style,   
    name=Satz,       
    numbered=no]{proposition}

\declaretheorem[style=plain-style,   
    name=Lemma,      
    numbered=no]{lemma}

\declaretheorem[style=plain-style,   
    name=Korollar,   
    numbered=no]{corollary}

\declaretheorem[style=upshape-style, 
    name=Beispiel,   
    numbered=no]{example}

\declaretheorem[style=upshape-style, 
    name=Beispiele,  
    numbered=no]{examples}

\declaretheorem[style=upshape-style, 
    name=Definition, 
    numbered=no]{definition}

\declaretheorem[style=small-style,   
    name=Anmerkung,  
    numbered=no]{remark}

\declaretheorem[style=small-style,   
    name=Anmerkungen,
    numbered=no]{remarks}

%% -- Spezielle Umgebungen
%% --
\declaretheorem[style=special-style, 
    name=Zusammenfassung, 
    numbered=no]{summary}
    
\declaretheorem[style=special-style, 
    name=Frage,           
    numbered=no]{question}
    
%% -- Kurzform

\declaretheorem[style=plain-style,   
    name=Theorem,    
    refname={Theorem,Theoreme},
    sibling=ntheorem]{thm}

\declaretheorem[style=plain-style,   
    name=Satz,       
    refname={Satz,Sätze},
    sibling=ntheorem]{prop}

\declaretheorem[style=plain-style,   
    name=Lemma,      
    refname={Lemma,Lemmata},
    sibling=ntheorem]{lem}

\declaretheorem[style=plain-style,
    name=Korollar,   
    refname={Korollar,Korollare},
    sibling=ntheorem]{cor}

\declaretheorem[style=upshape-style, 
    name=Beispiel,   
    refname={Beispiel,Beispiele},
    sibling=ntheorem]{exam}

\declaretheorem[style=upshape-style, 
    name=Beispiele,  
    refname={Beispiele,Beispiele},
    sibling=ntheorem]{exams}

\declaretheorem[style=upshape-style, 
    name=Definition, 
    refname={Definition,Definitionen},
    sibling=ntheorem]{defn}
    
\declaretheorem[style=small-style,   
    name=Anmerkung,  
    refname={Anmerkung,Anmerkungen},
    sibling=ntheorem]{rem}
    
\declaretheorem[style=small-style, 
    name=Anmerkungen,
    refname={Anmerkungen,Anmerkungen},
    sibling=ntheorem]{rems}

